# Copy to .env and fill in with YOUR Converge credentials (from your Elavon/Converge account).
# These live ONLY on the server — never in the website / browser.

CONVERGE_MERCHANT_ID=your_converge_account_id
CONVERGE_USER_ID=your_hosted_payments_api_user
CONVERGE_PIN=your_user_pin_or_api_key

# 'demo' while testing with Converge's sandbox, 'production' when live
CONVERGE_ENV=demo

# Lock this to your website's domain in production, e.g. https://primedealsrental.com
ALLOWED_ORIGIN=*

PORT=8080
